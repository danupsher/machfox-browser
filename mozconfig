# PowerFox Tiger PPC cross-compile mozconfig
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-ppc-tiger

CROSS_PREFIX=/mnt/media/claude_cross/ppc-prefix
CROSS_TOOLCHAIN=/mnt/media/claude_cross/toolchain/bin
CROSS_SDK=/mnt/media/claude_cross/sdks/MacOSX10.4u.sdk

# Cross-compile target
ac_add_options --target=powerpc-apple-darwin8
ac_add_options --with-macos-sdk=$CROSS_SDK
ac_add_options --enable-macos-target=10.4

# Compilers
export CC="$CROSS_TOOLCHAIN/ppc-tiger-gcc"
export CXX="$CROSS_TOOLCHAIN/ppc-tiger-g++"
export CPP="$CC -E"
export AR="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-ar"
export RANLIB="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-ranlib"
export STRIP="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-strip"
export TOOLCHAIN_PREFIX="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-"

# Host compilers (for build tools that run on Linux)
export HOST_CC=gcc
export HOST_CXX=g++

# SDK/prefix flags
export CFLAGS="-mcpu=970 -D_DARWIN_C_SOURCE -include /mnt/media/claude_cross/toolchain/include/tiger-compat.h -I$CROSS_PREFIX/include -isysroot $CROSS_SDK"
export CXXFLAGS="-mcpu=970 -D_DARWIN_C_SOURCE -include /mnt/media/claude_cross/toolchain/include/tiger-compat.h -I$CROSS_PREFIX/include -isysroot $CROSS_SDK"
export LDFLAGS="-L$CROSS_PREFIX/lib -Wl,-syslibroot,$CROSS_SDK"

# Application
ac_add_options --enable-application=basilisk

# Disable features that won't work on Tiger
ac_add_options --disable-webrtc
ac_add_options --disable-gamepad
ac_add_options --disable-av1
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-tests
ac_add_options --disable-debug
ac_add_options --enable-optimize="-O2 -mcpu=970"
ac_add_options --disable-jemalloc
ac_add_options --disable-sandbox
ac_add_options --disable-apple-media

# Static build
ac_add_options --enable-default-toolkit=cairo-cocoa
ac_add_options --disable-shared-js
