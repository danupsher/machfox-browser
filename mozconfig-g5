# Tiger PPC cross-compile mozconfig — G5 target (-mcpu=970)
# Uses GCC 15 + ld64 pipeline (fully local, no SSH)
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-ppc-g5

CROSS_PREFIX=/mnt/media/claude_cross/ppc-prefix
CROSS_TOOLCHAIN=/mnt/media/claude_cross/toolchain/bin
CROSS_SDK=/mnt/media/claude_cross/sdk_extract/macosx104/SDKs/MacOSX10.4u.sdk

# Cross-compile target
ac_add_options --target=powerpc-apple-darwin8
ac_add_options --with-macos-sdk=$CROSS_SDK
ac_add_options --enable-macos-target=10.4

# Compilers — GCC 15 + ld64 (fully local, no SSH needed)
export CC="$CROSS_TOOLCHAIN/ppc-ld64-gcc"
export CXX="$CROSS_TOOLCHAIN/ppc-ld64-g++"
export CPP="$CC -E"
export AR="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-ar"
export RANLIB="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-ranlib"
export STRIP="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-strip"
export TOOLCHAIN_PREFIX="$CROSS_TOOLCHAIN/powerpc-apple-darwin8-"

# Host compilers (for build tools that run on Linux)
export HOST_CC=gcc
export HOST_CXX=g++

# CRITICAL: PPC_TARGET=g5 selects G5 runtime libs (libgcc.a, libstdc++.a etc)
# and sets correct ppc970 Mach-O subtype. Without this, G3 libs get linked!
export PPC_TARGET=g5

# SDK/prefix flags — G5 optimized (-mcpu=970, enables fcfid etc)
# Note: -isysroot is handled by the ld64 wrapper internally
export CFLAGS="-mcpu=970 -mno-powerpc64 -D_DARWIN_C_SOURCE -DU_HAVE_TIMEZONE=0 -include /mnt/media/claude_cross/toolchain/include/tiger-compat.h -I$CROSS_PREFIX/include"
export CXXFLAGS="-mcpu=970 -mno-powerpc64 -D_DARWIN_C_SOURCE -DU_HAVE_TIMEZONE=0 -include /mnt/media/claude_cross/toolchain/include/tiger-compat.h -I$CROSS_PREFIX/include"
export LDFLAGS="-L$CROSS_PREFIX/lib"

# Application
ac_add_options --enable-application=basilisk

# Disable features that won't work on Tiger
ac_add_options --disable-webrtc
ac_add_options --disable-gamepad
ac_add_options --disable-av1
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-tests
ac_add_options --disable-debug
ac_add_options --enable-optimize="-O3 -mcpu=970 -mno-powerpc64 -ftree-vectorize -funroll-loops"
ac_add_options --disable-jemalloc
ac_add_options --disable-sandbox
ac_add_options --disable-apple-media

# Static build
ac_add_options --enable-default-toolkit=cairo-cocoa
ac_add_options --disable-shared-js

# Unofficial branding
ac_add_options --with-branding=basilisk/branding/unofficial
